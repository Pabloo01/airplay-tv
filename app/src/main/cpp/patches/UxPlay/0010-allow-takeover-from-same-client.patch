@@ -126,6 +126,21 @@ typedef struct raop_conn_s raop_conn_t;
 #include "raop_handlers.h"
 #include "http_handlers.h"
 
+/* true when every open RAOP connection comes from the same remote address as conn: the current
+ * client reconnecting (e.g. after a Wi-Fi drop left its old connection half-open), not another one */
+static bool
+conn_from_current_client(raop_t *raop, raop_conn_t *conn) {
+    int count = httpd_count_connection_type(raop->httpd, CONNECTION_TYPE_RAOP);
+    for (int i = 1; i <= count; i++) {
+        raop_conn_t *other = (raop_conn_t *) httpd_get_connection_by_type(raop->httpd, CONNECTION_TYPE_RAOP, i);
+        if (!other || other->remotelen != conn->remotelen ||
+            memcmp(other->remote, conn->remote, (size_t) conn->remotelen)) {
+            return false;
+        }
+    }
+    return count > 0;
+}
