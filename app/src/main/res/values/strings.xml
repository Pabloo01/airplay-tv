    <string name="setting_realtime_decoder_priority_desc">Pide prioridad de tiempo real (MediaFormat.KEY_PRIORITY) al decodificador de audio para evitar cortes. Se aplica al momento y no afecta al vídeo</string>
    <string name="setting_operating_rate">MediaFormat.KEY_OPERATING_RATE</string>
    <string name="setting_operating_rate_desc">Pide al decodificador su velocidad máxima de funcionamiento</string>
