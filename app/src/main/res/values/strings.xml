    <!-- Settings: Decode -->
    <string name="setting_h265">H.265 (HEVC)</string>
    <string name="setting_h265_desc">Desactivado por defecto: en algunos televisores el duplicado en H.265 se ve en negro. En automático solo usa decodificadores H.265 que se sabe que funcionan</string>
    <string name="setting_enforce_sdr">MediaFormat.KEY_COLOR_TRANSFER</string>
    <string name="setting_enforce_sdr_desc">Marca el vídeo como SDR limitado; desactívalo para dejar pasar fuentes HDR</string>
    <string name="setting_sw_alac">Forzar decodificador ALAC por software</string>
    <string name="setting_sw_alac_desc">Usa siempre el decodificador ALAC por software en vez del del sistema; puede afectar a la latencia</string>
    <string name="setting_sw_aac">Forzar decodificador AAC por software</string>
    <string name="setting_sw_aac_desc">Usa siempre el decodificador AAC por software en vez del del sistema; puede afectar a la latencia</string>
    <string name="setting_sync_client_volume">Sincronizar volumen del emisor</string>
    <string name="setting_sync_client_volume_desc">Usa el volumen del emisor como volumen del receptor</string>

